// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

enum Role {
  USER
  ADMIN
}

enum CasinoRole {
  OWNER
  FLOOR
}

enum OAuthProvider {
  FORTY_TWO
  GITHUB
  GOOGLE
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String? // ? = optionnel (comptes OAuth)
  firstName     String
  lastName      String
  birthDate     DateTime
  phone         String? // pour les notifs ?
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  memberships   Membership[]
  oauthAccounts OAuthAccount[]
}

model Casino {
  id          String       @id @default(uuid())
  name        String
  city        String
  address     String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  memberships Membership[]
}

model Membership {
  id        String     @id @default(uuid())
  userId    String
  casinoId  String
  role      CasinoRole @default(FLOOR)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  casino    Casino     @relation(fields: [casinoId], references: [id])
  createdAt DateTime   @default(now())

  @@unique([userId, casinoId])
  @@index([casinoId])
}

model OAuthAccount {
  id                String        @id @default(uuid()) // uuid dans la table
  userId            String // renvoie a ligne user correpodant dans la table user 
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade) // lien vers table user
  provider          OAuthProvider // enum avec le type OAuth
  providerAccountId String // id retourner par le OAuth choisis
  createdAt         DateTime      @default(now()) // date de creation

  @@unique([provider, providerAccountId])
  @@index([userId])
}
