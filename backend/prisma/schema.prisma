// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// lexique :
// id        = identifiant unique de la ligne (clé primaire)
// xxxId     = clé étrangère : contient l'id d'une ligne d'une autre table (ex. userId -> User.id)
// user      = champ de relation Prisma, virtuel (aucune colonne en base) : permet d'écrire include: { user: true }
// onDelete: Cascade = supprimer la ligne parente supprime aussi les lignes qui pointent vers elle
// @@unique  = interdit deux lignes avec la même combinaison de valeurs
//             ex. Membership [userId, casinoId] : un user ne peut pas être membre deux fois du même casino,
//             mais peut être membre de plusieurs casinos
// @@index   = accélère les recherches sur ces colonnes (ex. "tous les comptes OAuth d'un userId")
//

enum Role {
  USER
  ADMIN
}

enum CasinoRole {
  OWNER
  FLOOR
}

enum OAuthProvider {
  FORTY_TWO
  GITHUB
  GOOGLE
}

enum PokerVariant {
  TEXAS_HOLDEM
  OMAHA
}

enum TableStatus {
  OPEN
  PAUSED
}

enum SeatStatus {
  FREE
  OCCUPIED
}

enum ReservationStatus {
  PENDING_PAYMENT
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum NotificationType {
  RESERVATION_CONFIRMED
  RESERVATION_MODIFIED
  RESERVATION_CANCELLED
  SEAT_FREED
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  pseudo        String         @unique // pseudo affiché, stocké en minuscules
  passwordHash  String? // ? = optionnel (comptes OAuth)
  firstName     String
  lastName      String
  birthDate     DateTime
  phone         String? // pour les notifs ?
  role          Role           @default(USER) //role sur notre site, simple user ou admin avec des droits dacces priviligies 
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime? // RGPD : null = compte actif, date = compte anonymisé
  memberships   Membership[]
  oauthAccounts OAuthAccount[]
  reservations  Reservation[]
  notifications Notification[]
}

model Casino {
  id          String       @id @default(uuid())
  name        String
  city        String
  address     String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  memberships Membership[]
  tables      PokerTable[]
}

model Membership {
  id        String     @id @default(uuid())
  userId    String
  casinoId  String
  role      CasinoRole @default(FLOOR) // role un d'un membership au sein du casino
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  casino    Casino     @relation(fields: [casinoId], references: [id])
  createdAt DateTime   @default(now())

  @@unique([userId, casinoId])
  @@index([casinoId])
}

model OAuthAccount {
  id                String        @id @default(uuid()) // identifiant de CE compte OAuth (clé primaire)
  userId            String // renvoie a ligne user correpodant dans la table user, clé étrangère : id du User propriétaire (plusieurs comptes OAuth possibles par user)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade) // lien vers table user, supprimer le user supprime ses comptes OAuth
  provider          OAuthProvider // enum avec le type OAuth : 42, GitHub ou Google
  providerAccountId String // id de l'utilisateur CHEZ le provider
  createdAt         DateTime      @default(now()) // date de creation

  // sécurité : un compte externe ne peut être lié qu'à un seul user
  @@unique([provider, providerAccountId])
  // accélère "tous les comptes OAuth d'un user",  un index sert à retrouver des lignes sans parcourir toute la table.
  @@index([userId])
}

model PokerTable {
  id             String       @id @default(uuid())
  casinoId       String
  name           String
  variant        PokerVariant
  smallBlind     Int
  bigBlind       Int
  maxSeats       Int
  status         TableStatus  @default(OPEN)
  moneyOnTable   Int          @default(0)
  casino         Casino       @relation(fields: [casinoId], references: [id], onDelete: Restrict)
  moneyUpdatedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  seats          Seat[]
}

model Seat {
  id           String        @id @default(uuid())
  tableId      String
  seatNumber   Int
  status       SeatStatus    @default(FREE)
  table        PokerTable    @relation(fields: [tableId], references: [id], onDelete: Restrict)
  deletedAt    DateTime?
  reservations Reservation[]

  @@unique([tableId, seatNumber])
}

model Reservation {
  id            String            @id @default(uuid())
  userId        String
  seatId        String
  status        ReservationStatus
  seat          Seat              @relation(fields: [seatId], references: [id], onDelete: Restrict)
  user          User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  arrivalAt     DateTime
  seatedAt      DateTime?
  leftAt        DateTime?
  cancelledAt   DateTime?
  payment       Payment?
  notifications Notification[]

  @@index([userId])
  @@index([seatId])
}

model Payment {
  id                    String        @id @default(uuid())
  reservationId         String        @unique
  amount                Int
  status                PaymentStatus @default(PENDING)
  stripePaymentIntentId String        @unique
  stripeRefundId        String?       @unique
  reservation           Reservation   @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  createdAt             DateTime      @default(now())
  paidAt                DateTime?
  refundedAt            DateTime?
}

model Notification {
  id            String           @id @default(uuid())
  userId        String
  reservationId String?
  type          NotificationType
  params        Json
  reservation   Reservation?     @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())
  readAt        DateTime? // null = non lue

  @@index([userId, readAt])
}
